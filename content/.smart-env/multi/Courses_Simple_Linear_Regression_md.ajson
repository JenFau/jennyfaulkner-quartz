:[162,165],"#create a model object":[166,168],"#create a model object#{1}":[167,168],"#train the model on the training data":[169,169],"#X_train is a 1-D array but sklearn models expect a 2D array as input for the training data, with shape (n_observations, n_features).":[170,170],"#So we need to reshape it. We can let it infer the number of observations using '-1'.":[171,173],"#So we need to reshape it. We can let it infer the number of observations using '-1'.#{1}":[172,173],"#Print the coefficients":[174,203],"#Print the coefficients#{1}":[175,179],"#Print the coefficients##Visualize model outputs":[180,203],"#Print the coefficients##Visualize model outputs#{1}":[182,189],"#Print the coefficients##Visualize model outputs#Model evaluation":[190,203],"#Print the coefficients##Visualize model outputs#Model evaluation#{1}":[191,193],"#Print the coefficients##Visualize model outputs#Model evaluation#{2}":[194,195],"#Print the coefficients##Visualize model outputs#Model evaluation#{3}":[196,197],"#Print the coefficients##Visualize model outputs#Model evaluation#{4}":[198,199],"#Print the coefficients##Visualize model outputs#Model evaluation#{5}":[200,201],"#Print the coefficients##Visualize model outputs#Model evaluation#{6}":[202,203],"#Use the predict method to make test predictions":[204,206],"#Use the predict method to make test predictions#{1}":[205,206],"#Evaluation":[207,250],"#Evaluation#{1}":[208,211],"#Evaluation#Practice exercises":[212,250],"#Evaluation#Practice exercises##1. Plot the regression model result over the test data instead of the training data. Visually evaluate whether the result is good.":[214,229],"#Evaluation#Practice exercises##1. Plot the regression model result over the test data instead of the training data. Visually evaluate whether the result is good.#{1}":[216,229],"#Evaluation#Practice exercises##2. Select the fuel consumption feature from the dataframe and split the data 80%/20% into training and testing sets.":[230,245],"#Evaluation#Practice exercises##2. Select the fuel consumption feature from the dataframe and split the data 80%/20% into training and testing sets.#{1}":[231,245],"#Evaluation#Practice exercises##3.  Train a linear regression model using the training data you created.":[246,250],"#Evaluation#Practice exercises##3.  Train a linear regression model using the training data you created.#{1}":[247,250],"#ADD CODE":[251,276],"#ADD CODE#{1}":[253,262],"#ADD CODE###4. Use the model to make test predictions on the fuel consumption testing data.":[263,274],"#ADD CODE###4. Use the model to make test predictions on the fuel consumption testing data.#{1}":[265,274],"#ADD CODE###5. Calculate and print the Mean Squared Error of the test predictions.":[275,276],"#ADD CODE[2]":[277,308],"#ADD CODE[2]#{1}":[278,287],"#ADD CODE[2]##Congratulations! You're ready to move on to your next lesson.":[288,290],"#ADD CODE[2]#Author":[291,296],"#ADD CODE[2]#Author#{1}":[292,293],"#ADD CODE[2]#Author#Other Contributors":[294,296],"#ADD CODE[2]#Author#Other Contributors#{1}":[295,296],"#ADD CODE[2]#<h3 align=\"center\"> © IBM Corporation. All rights reserved. <h3/>":[297,299],"#ADD CODE[2]#<h3 align=\"center\"> © IBM Corporation. All rights reserved. <h3/>#{1}":[299,299],"#ADD CODE[2]#Changelog":[300,308],"#ADD CODE[2]#Changelog#{1}":[301,308]},"outlinks":[{"title":"Dataset source","target":"http://open.canada.ca/data/en/dataset/98f1a129-f628-4ce4-b24d-6f16bf24dd64","line":60},{"title":"'ENGINESIZE','CYLINDERS','FUELCONSUMPTION_COMB','CO2EMISSIONS'","target":"'ENGINESIZE','CYLINDERS','FUELCONSUMPTION_COMB','CO2EMISSIONS'","line":92},{"title":"'CYLINDERS','ENGINESIZE','FUELCONSUMPTION_COMB','CO2EMISSIONS'","target":"'CYLINDERS','ENGINESIZE','FUELCONSUMPTION_COMB','CO2EMISSIONS'","line":99},{"title":"Scikit-Learn Linear Regression documentation","target":"https://scikit-learn.org/stable/modules/generated/sklearn.linear_model.LinearRegression.html","line":162}],"metadata":{"tags":["#ADD"]},"task_lines":[],"