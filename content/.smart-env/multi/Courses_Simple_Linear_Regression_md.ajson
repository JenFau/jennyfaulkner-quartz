],"#create a model object":[164,166],"#create a model object#{1}":[165,166],"#train the model on the training data":[167,167],"#X_train is a 1-D array but sklearn models expect a 2D array as input for the training data, with shape (n_observations, n_features).":[168,168],"#So we need to reshape it. We can let it infer the number of observations using '-1'.":[169,171],"#So we need to reshape it. We can let it infer the number of observations using '-1'.#{1}":[170,171],"#Print the coefficients":[172,201],"#Print the coefficients#{1}":[173,177],"#Print the coefficients##Visualize model outputs":[178,201],"#Print the coefficients##Visualize model outputs#{1}":[180,187],"#Print the coefficients##Visualize model outputs#Model evaluation":[188,201],"#Print the coefficients##Visualize model outputs#Model evaluation#{1}":[189,191],"#Print the coefficients##Visualize model outputs#Model evaluation#{2}":[192,193],"#Print the coefficients##Visualize model outputs#Model evaluation#{3}":[194,195],"#Print the coefficients##Visualize model outputs#Model evaluation#{4}":[196,197],"#Print the coefficients##Visualize model outputs#Model evaluation#{5}":[198,199],"#Print the coefficients##Visualize model outputs#Model evaluation#{6}":[200,201],"#Use the predict method to make test predictions":[202,204],"#Use the predict method to make test predictions#{1}":[203,204],"#Evaluation":[205,248],"#Evaluation#{1}":[206,209],"#Evaluation#Practice exercises":[210,248],"#Evaluation#Practice exercises##1. Plot the regression model result over the test data instead of the training data. Visually evaluate whether the result is good.":[212,227],"#Evaluation#Practice exercises##1. Plot the regression model result over the test data instead of the training data. Visually evaluate whether the result is good.#{1}":[214,227],"#Evaluation#Practice exercises##2. Select the fuel consumption feature from the dataframe and split the data 80%/20% into training and testing sets.":[228,243],"#Evaluation#Practic