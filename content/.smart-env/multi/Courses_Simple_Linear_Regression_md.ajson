h some randomly selected records#Understand the data#Explore the data#Visualize features#{1}":[95,123],"#verify successful load with some randomly selected records#Understand the data#Explore the data#Practice excercise 1":[124,126],"#verify successful load with some randomly selected records#Understand the data#Explore the data#Practice excercise 1#{1}":[125,126],"#write your code here":[127,164],"#write your code here#{1}":[128,139],"#write your code here##Extract the input feature and labels from the dataset":[140,158],"#write your code here##Extract the input feature and labels from the dataset#{1}":[141,145],"#write your code here##Extract the input feature and labels from the dataset#Create train and test datasets":[146,158],"#write your code here##Extract the input feature and labels from the dataset#Create train and test datasets#{1}":[147,158],"#write your code here##Build a simple linear regression model":[159,164],"#write your code here##Build a simple linear regression model#{1}":[161,164],"#create a model object":[165,167],"#create a model object#{1}":[166,167],"#train the model on the training data":[168,168],"#X_train is a 1-D array but sklearn models expect a 2D array as input for the training data, with shape (n_observations, n_features).":[169,169],"#So we need to reshape it. We can let it infer the number of observations using '-1'.":[170,172],"#So we need to reshape it. We can let it infer the number of observations using '-1'.#{1}":[171,172],"#Print the coefficients":[173,202],"#Print the coefficients#{1}":[174,178],"#Print the coefficients##Visualize model outputs":[179,202],"#Print the coefficients##Visualize model outputs#{1}":[181,188],"#Print the coefficients##Visualize model outputs#Model evaluation":[189,202],"#Print the coefficients##Visualize model outputs#Model evaluation#{1}":[190,192],"#Print the coefficients##Visualize model outputs#Model evaluation#{2}":[193,194],"#Print the coefficients##Visualize model outputs#Model evaluation#{3